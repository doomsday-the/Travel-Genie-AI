# Copy to .env and fill in real values. Never commit .env
DJANGO_SECRET_KEY=django-insecure-travelgenie-key-development-secret-2026
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=travelgenie
DB_USER=travelgenie
DB_PASSWORD=travelgenie_secret
DB_HOST=db
DB_PORT=5432

# Set to True for zero-dependency local development (SQLite) without PostgreSQL
USE_SQLITE=False

# AI Planner API (Gemini or Groq free tier)
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-or-groq-key
LLM_MODEL=gemini-1.5-flash
